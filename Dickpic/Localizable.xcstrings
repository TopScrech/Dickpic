    "1. Open Settings" : {
      "comment" : "A step in the process of enabling sensitive content warnings, describing the action to open settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Open Instellingen"
